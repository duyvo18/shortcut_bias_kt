# Copy this file to .env in the repository root before running the pilot.
# Do not commit .env or put secrets in this sample file.

# CUDA device selection. The RTX 3060 is normally device 0.
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0

# Native CPU thread pools for pandas/NumPy/Torch-adjacent work.
# This does not parallelize Python loops inside pyKT 0.0.38.
PILOT_CPU_THREADS=20
PILOT_CPU_INTEROP_THREADS=2
OMP_NUM_THREADS=20
OPENBLAS_NUM_THREADS=20
MKL_NUM_THREADS=20
NUMEXPR_NUM_THREADS=20

# Optional project behavior.
# PILOT_OUTPUT_DIR=outputs
# WANDB_MODE=disabled
# WANDB_PROJECT=shortcut-bias-pilot
